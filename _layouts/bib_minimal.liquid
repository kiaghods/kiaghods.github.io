---
---
<div class="paper">
  <div class="paper-title">{% if entry.url %}<a href="{{ entry.url }}">{{ entry.title }}</a>{% elsif entry.arxiv %}<a href="https://arxiv.org/abs/{{ entry.arxiv }}">{{ entry.title }}</a>{% elsif entry.doi %}<a href="https://doi.org/{{ entry.doi }}">{{ entry.title }}</a>{% else %}{{ entry.title }}{% endif %}</div>
  <div class="paper-authors">
  {%- for author in entry.author_array -%}
    {%- assign author_last_clean = author.last | regex_replace: '[*∗†‡§¶‖&^]', '' -%}
    {%- assign is_self = false -%}
    {%- if site.scholar.last_name contains author_last_clean -%}
      {%- if site.scholar.first_name contains author.first -%}
        {%- assign is_self = true -%}
      {%- endif -%}
    {%- endif -%}
    {%- if is_self -%}<strong>{{ author.first }} {{ author.last }}</strong>{%- else -%}{{ author.first }} {{ author.last }}{%- endif -%}
    {%- unless forloop.last -%}, {% endunless -%}
  {%- endfor -%}
  </div>
  <div class="paper-venue">{% if entry.type == 'inproceedings' or entry.type == 'incollection' %}{{ entry.booktitle }}{% else %}{{ entry.journal }}{% endif %} · {{ entry.year }}</div>
</div>
