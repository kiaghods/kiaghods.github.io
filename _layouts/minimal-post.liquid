---
layout: minimal
---

<a href="/blog/" class="studio-back">↑ the studio</a>

<article class="post">

<h1 class="post-title-large">{{ page.title }}</h1>

{% if page.description %}
<p class="post-subtitle">{{ page.description }}</p>
{% endif %}

<p class="post-meta-line">
{{ page.date | date: "%B %-d, %Y" }}
{% assign words = content | number_of_words %}
{% if words > 0 %}
{% assign read_time = words | divided_by: 200 | plus: 1 %}
&nbsp;·&nbsp; {{ read_time }} min read
{% endif %}
</p>

<div class="post-body">
{{ content }}
</div>

</article>
