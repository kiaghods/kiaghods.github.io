<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ page.title | default: site.title }}</title>
  <meta name="description" content="{{ page.description | default: site.description }}">
  {% if page.noindex %}
  <meta name="robots" content="noindex, nofollow">
  {% endif %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=Roboto+Mono:wght@400&family=Caveat:wght@400;500&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" crossorigin="anonymous">
  <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js" crossorigin="anonymous"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js" crossorigin="anonymous"
    onload="renderMathInElement(document.body, {delimiters: [{left: '$', right: '$', display: false}, {left: '$$', right: '$$', display: true}]});"></script>

  <style>
    html {
      font-size: 19px;
    }
    body {
      font-family: "EB Garamond", Garamond, Georgia, serif;
      font-weight: 400;
      line-height: 1.6;
      color: #1c1c1c;
      background: #f7f3e9;
      max-width: 38em;
      margin: 3.5em auto 5em;
      padding: 0 1.25em;
      font-feature-settings: "liga", "onum", "kern";
    }
    a {
      color: #1c1c1c;
      text-decoration: underline;
      text-decoration-thickness: 0.5px;
      text-underline-offset: 2px;
      text-decoration-color: #a89878;
    }
    a:hover {
      text-decoration-color: #1c1c1c;
      color: #6a1a1a;
    }
    code, kbd, .mono {
      font-family: "Roboto Mono", ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
      font-size: 0.82em;
      color: #4a4a4a;
    }
    em { font-style: italic; }
    strong { font-weight: 500; }
    h1, h2, h3 {
      font-family: "EB Garamond", serif;
      font-weight: 500;
      font-size: 1.08em;
      margin: 2.6em 0 0.9em;
      font-variant: small-caps;
      letter-spacing: 0.1em;
      color: #2c2620;
      padding-bottom: 0.3em;
      border-bottom: 1px solid #e3dbc8;
    }
    h1 { margin-top: 0; }
    p { margin: 0.7em 0; }

    .masthead { margin-bottom: 2.5em; }
    .masthead-top {
      display: flex;
      align-items: flex-start;
      gap: 1.5em;
      margin-bottom: 1.2em;
    }
    .masthead-text { flex: 1; min-width: 0; }
    .masthead .avatar {
      width: 96px;
      height: 96px;
      border-radius: 50%;
      object-fit: cover;
      flex-shrink: 0;
      margin-top: 0.2em;
      filter: saturate(0.92);
    }
    .masthead .name {
      font-family: "EB Garamond", serif;
      font-size: 1.35em;
      font-weight: 500;
      font-variant: small-caps;
      letter-spacing: 0.09em;
      margin: 0 0 0.4em;
      color: #1c1c1c;
    }
    .masthead .lede {
      margin: 0.3em 0 0.9em;
    }
    @media (max-width: 480px) {
      .masthead .avatar { width: 72px; height: 72px; }
      .masthead-top { gap: 1em; }
    }
    .masthead .nav {
      display: flex;
      flex-wrap: wrap;
      gap: 0.7em;
      align-items: baseline;
      margin: 0.6em 0 1.4em;
      color: #5a5048;
    }
    .masthead .nav-sep {
      color: #a89878;
      user-select: none;
    }
    .masthead .affil {
      margin: 0.15em 0;
      padding-left: 0;
    }
    .masthead .affil .arrow {
      color: #a89878;
      display: inline-block;
      width: 1.2em;
    }
    .masthead .dim {
      color: #7a7268;
    }
    .masthead .contact {
      margin: 1.3em 0 0.3em;
      color: #5a5048;
    }

    ul.qlist {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    ul.qlist li {
      margin: 0.85em 0;
    }
    ul.qlist-fade,
    p.qprose-fade {
      -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 25%, rgba(0,0,0,0.3) 100%);
      mask-image: linear-gradient(to bottom, #000 0%, #000 25%, rgba(0,0,0,0.3) 100%);
    }

    ul.qdiffuse {
      list-style: none;
      padding: 0;
      margin: 0.4em 0 0;
    }
    ul.qdiffuse li {
      margin: 0.75em 0;
      line-height: 1.5;
      transition: transform 0.25s ease, filter 0.25s ease, opacity 0.25s ease;
    }
    /* Diffusion scatter/opacity/blur — commented out while trying alternative effects.
    ul.qdiffuse li:nth-child(1)  { transform: translateX(0);        opacity: 1.00; }
    ul.qdiffuse li:nth-child(2)  { transform: translateX(-0.6em);   opacity: 0.96; }
    ul.qdiffuse li:nth-child(3)  { transform: translateX(2.2em);    opacity: 0.90; }
    ul.qdiffuse li:nth-child(4)  { transform: translateX(-0.2em);   opacity: 0.83; }
    ul.qdiffuse li:nth-child(5)  { transform: translateX(3em);      opacity: 0.76; }
    ul.qdiffuse li:nth-child(6)  { transform: translateX(0.8em);    opacity: 0.68; filter: blur(0.2px); }
    ul.qdiffuse li:nth-child(7)  { transform: translateX(-1.6em);   opacity: 0.60; filter: blur(0.3px); }
    ul.qdiffuse li:nth-child(8)  { transform: translateX(3.6em);    opacity: 0.54; filter: blur(0.35px); }
    ul.qdiffuse li:nth-child(9)  { transform: translateX(0.5em);    opacity: 0.48; filter: blur(0.45px); }
    ul.qdiffuse li:nth-child(10) { transform: translateX(-1em);     opacity: 0.42; filter: blur(0.55px); }
    ul.qdiffuse li:nth-child(11) { transform: translateX(2.5em);    opacity: 0.37; filter: blur(0.65px); }
    ul.qdiffuse li:nth-child(12) { transform: translateX(1.3em);    opacity: 0.33; filter: blur(0.75px); }
    ul.qdiffuse li:nth-child(13) { transform: translateX(-0.6em);   opacity: 0.28; filter: blur(0.85px); }
    ul.qdiffuse li:nth-child(14) { transform: translateX(3.2em);    opacity: 0.24; filter: blur(0.95px); }
    ul.qdiffuse li:nth-child(15) { transform: translateX(0.7em);    opacity: 0.20; filter: blur(1.05px); }
    ul.qdiffuse li:nth-child(n+16) { transform: translateX(1em);    opacity: 0.18; filter: blur(1.15px); }

    ul.qdiffuse li:hover,
    ul.qdiffuse li:focus-within {
      transform: translateX(0) !important;
      opacity: 1 !important;
      filter: none !important;
    }
    */

    /* === Effect demos === */

    /* 1. Attention heatmap — reveals on hover */
    ul.qatt {
      list-style: none;
      padding: 0;
      margin: 0.4em 0 0;
    }
    ul.qatt li {
      margin: 0.85em 0;
      line-height: 1.55;
    }
    ul.qatt a {
      color: #1c1c1c;
      text-decoration: underline;
      text-decoration-thickness: 0.5px;
      text-underline-offset: 2px;
      text-decoration-color: #a89878;
    }
    ul.qatt .qatt-word {
      padding: 0 0.08em;
      border-radius: 2px;
      transition: background-color 0.18s ease;
    }
    ul.qatt a:hover .qatt-word {
      background-color: hsla(32, 80%, 52%, calc(var(--w) * 0.30));
    }

    /* 2. Handwritten ink draw */
    ul.qink {
      list-style: none;
      padding: 0;
      margin: 0.4em 0 0;
    }
    ul.qink li {
      margin: 1em 0;
      line-height: 1.35;
      font-family: "Caveat", "EB Garamond", cursive, serif;
      font-size: 1.35em;
      overflow: hidden;
    }
    ul.qink li a {
      color: #2c2620;
      text-decoration: none;
      border-bottom: 1px solid rgba(168, 152, 120, 0.45);
      display: inline-block;
      clip-path: inset(0 100% 0 0);
      animation: inkdraw 1.8s cubic-bezier(0.45, 0.05, 0.25, 1) forwards;
    }
    ul.qink li:nth-child(1) a { animation-delay: 0s; }
    ul.qink li:nth-child(2) a { animation-delay: 0.3s; }
    ul.qink li:nth-child(3) a { animation-delay: 0.6s; }
    ul.qink li:nth-child(4) a { animation-delay: 0.9s; }
    ul.qink li:nth-child(5) a { animation-delay: 1.2s; }
    ul.qink li:nth-child(6) a { animation-delay: 1.5s; }
    ul.qink li:nth-child(7) a { animation-delay: 1.8s; }
    ul.qink li:nth-child(8) a { animation-delay: 2.1s; }
    @keyframes inkdraw {
      from { clip-path: inset(0 100% 0 0); }
      to   { clip-path: inset(0 0 0 0); }
    }
    ul.qink li a:hover {
      color: #6a1a1a;
      border-bottom-color: rgba(106, 26, 26, 0.55);
    }
    @media (prefers-reduced-motion: reduce) {
      ul.qink li a { animation: none; clip-path: none; }
    }

    /* Ebbinghaus decay — exponential opacity (R = e^(-kt), k tuned so last item ≈ 0.2)
       + focus flashlight (siblings dim+blur when one is hovered/focused) */
    ul.qdecay {
      list-style: none;
      padding: 0;
      margin: 0.4em 0 0;
    }
    ul.qdecay li {
      margin: 0.85em 0;
      line-height: 1.5;
      transition: opacity 0.25s ease, filter 0.25s ease;
    }
    ul.qdecay li:nth-child(1)  { opacity: 1.00; }
    ul.qdecay li:nth-child(2)  { opacity: 0.89; }
    ul.qdecay li:nth-child(3)  { opacity: 0.79; }
    ul.qdecay li:nth-child(4)  { opacity: 0.71; }
    ul.qdecay li:nth-child(5)  { opacity: 0.63; }
    ul.qdecay li:nth-child(6)  { opacity: 0.56; }
    ul.qdecay li:nth-child(7)  { opacity: 0.50; }
    ul.qdecay li:nth-child(8)  { opacity: 0.45; }
    ul.qdecay li:nth-child(9)  { opacity: 0.40; }
    ul.qdecay li:nth-child(10) { opacity: 0.36; }
    ul.qdecay li:nth-child(11) { opacity: 0.32; }
    ul.qdecay li:nth-child(12) { opacity: 0.28; }
    ul.qdecay li:nth-child(13) { opacity: 0.25; }
    ul.qdecay li:nth-child(14) { opacity: 0.22; }
    ul.qdecay li:nth-child(15) { opacity: 0.20; }
    ul.qdecay li:nth-child(n+16) { opacity: 0.18; }

    ul.qdecay:has(li:hover) li:not(:hover),
    ul.qdecay:has(li:focus-within) li:not(:focus-within) {
      opacity: 0.16 !important;
      filter: blur(0.5px);
    }
    ul.qdecay li:hover,
    ul.qdecay li:focus-within {
      opacity: 1 !important;
      filter: none;
    }

    .placeholder {
      color: #a07a30;
      font-style: italic;
    }

    ul.lately {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    ul.lately li {
      margin: 0.5em 0;
    }
    ul.lately em {
      font-style: italic;
    }

    hr {
      border: none;
      border-top: 1px solid #dcd4c2;
      margin: 3em 0;
    }

    details.papers {
      margin-top: 2.8em;
    }
    details.papers > summary {
      cursor: pointer;
      font-family: "EB Garamond", serif;
      font-weight: 500;
      font-size: 1.08em;
      font-variant: small-caps;
      letter-spacing: 0.1em;
      color: #2c2620;
      list-style: none;
      padding: 0;
      outline: none;
    }
    details.papers[open] > summary {
      padding-bottom: 0.3em;
      border-bottom: 1px solid #e3dbc8;
      margin-bottom: 1.2em;
    }
    details.papers > summary::-webkit-details-marker { display: none; }
    details.papers > summary::before {
      content: "[+]  ";
      display: inline-block;
      color: #8a7a5a;
      font-family: "Roboto Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      font-size: 0.82em;
      font-variant: normal;
      letter-spacing: 0;
    }
    details.papers[open] > summary::before {
      content: "[−]  ";
    }
    .paper {
      margin: 1.1em 0;
      line-height: 1.45;
    }
    .paper-title {
      font-weight: 500;
      font-size: 0.98em;
    }
    .paper-title a {
      text-decoration-color: #a89878;
    }
    .paper-authors {
      font-size: 0.88em;
      color: #4a4a4a;
      margin: 0.15em 0 0.1em;
    }
    .paper-authors strong {
      font-weight: 600;
      color: #1c1c1c;
    }
    .paper-venue {
      font-size: 0.85em;
      color: #7a7268;
      font-style: italic;
    }
    .papers-footer {
      margin-top: 1.6em;
      font-size: 0.88em;
      color: #7a7268;
    }

    @media (max-width: 600px) {
      html { font-size: 17.5px; }
      body { margin: 2em auto 3em; }
    }
  </style>
</head>
<body>
  {{ content }}
  <script>
    /* Diffusion denoise animation — commented out while trying alternative effects.
    (function() {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      var noiseChars = '!<>-_/\\[]{}—=+*^?#·~•¤§∆∇∂∫';
      var totalDuration = 3400;

      function setupList(list) {
        var items = Array.prototype.slice.call(list.querySelectorAll('li'));
        if (!items.length) return;
        var n = items.length;

        var state = items.map(function(li) {
          var link = li.querySelector('a') || li;
          var text = link.textContent;

          link.textContent = text.split('').map(function(c) {
            return c === ' ' ? ' ' : noiseChars[Math.floor(Math.random() * noiseChars.length)];
          }).join('');

          var s = { li: li, link: link, text: text, resolved: false, started: false };
          function resolve() {
            if (s.resolved) return;
            s.resolved = true;
            link.textContent = text;
          }
          s.resolve = resolve;
          li.addEventListener('mouseenter', resolve);
          li.addEventListener('focusin', resolve);
          return s;
        });

        function startAll() {
          state.forEach(function(s, index) {
