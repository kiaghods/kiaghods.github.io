                return Math.random() < denoiseProgress
                  ? c
                  : noiseChars[Math.floor(Math.random() * noiseChars.length)];
              }).join('');

              requestAnimationFrame(tick);
            }

            requestAnimationFrame(tick);
          });
        }

        if ('IntersectionObserver' in window) {
          var observer = new IntersectionObserver(function(entries) {
            entries.forEach(function(entry) {
              if (entry.isIntersecting) {
                startAll();
                observer.unobserve(entry.target);
              }
            });
          }, { threshold: 0.15 });
          observer.observe(list);
        } else {
          startAll();
        }
      }

      Array.prototype.forEach.call(document.querySelectorAll('ul.qdiffuse'), setupList);
    })();
    */

    /* Attention heatmap — wraps each word in a span with a pseudo-attention weight */
    (function() {
      function escapeHtml(s) {
        return s.replace(/[&<>"']/g, function(m) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m];
        });
      }

      Array.prototype.forEach.call(document.querySelectorAll('ul.qatt'), function(list) {
        Array.prototype.forEach.call(list.querySelectorAll('li'), function(li) {
          var link = li.querySelector('a') || li;
          var text = link.textContent;
          var tokens = text.split(/(\s+)/);
          var html = tokens.map(function(w) {
            if (w === '' || /^\s+$/.test(w)) return w;
            var stripped = w.replace(/[^a-zA-Z]/g, '');
            var lengthBias = Math.min(1, Math.max(0, (stripped.length - 2) / 8));
            var rand = Math.random() * 0.55;
            var weight = Math.min(1, lengthBias * 0.65 + rand);
            return '<span class="qatt-word" style="--w:' + weight.toFixed(2) + '">' + escapeHtml(w) + '</span>';
          }).join('');
          link.innerHTML = html;
        });
      });
    })();
  </script>
</body>
</html>
